# Base de datos
# — Desarrollo local: Postgres en Docker (ver docker-compose.yml)
DATABASE_URL="postgresql://arquiron:arquiron_dev_password@localhost:5432/arquiron_crm?schema=public"
DIRECT_URL="postgresql://arquiron:arquiron_dev_password@localhost:5432/arquiron_crm?schema=public"
# — Producción (Neon): usar la connection string "pooled" para DATABASE_URL
#   (runtime, con pgbouncer) y la "direct" para DIRECT_URL (migraciones).
#   Formato de referencia, sin credenciales reales:
# DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require"

# Google OAuth (para el login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=LEADS

# Refresh token del propietario (para endpoint público NPS por email)
# Obtener: iniciar sesión en el CRM y copiar refresh_token de la consola
# o ejecutar: npx ts-node scripts/get-refresh-token.ts
GOOGLE_OWNER_REFRESH_TOKEN=

# Apps Script (envío de emails: portal, evaluación, propuestas, NPS)
NEXT_PUBLIC_GOOGLE_SHEETS_ENDPOINT=

# Dominio autorizado para login
ALLOWED_DOMAIN=arquiron.com

# Emails con rol admin (separados por coma). Todo lo demás autenticado
# dentro del dominio permitido queda como rol "consultor".
ADMIN_EMAILS=
